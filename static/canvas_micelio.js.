// canvas_micelio.js
// Animación de crecimiento tipo micelio

let points = [];
let maxPoints = 500;
let growSpeed = 1;

function setup() {
  createCanvas(600, 600);
  background(10);
  stroke(255);
  strokeWeight(1);
  frameRate(30);

  // Punto inicial
  points.push({ x: width / 2, y: height / 2, angle: random(TWO_PI) });
}

function draw() {
  if (points.length < maxPoints) {
    let newPoints = [];
    for (let pt of points) {
      for (let i = 0; i < growSpeed; i++) {
        let angle = pt.angle + random(-PI / 3, PI / 3);
        let x = pt.x + cos(angle) * random(3, 6);
        let y = pt.y + sin(angle) * random(3, 6);

        if (x > 0 && x < width && y > 0 && y < height) {
          stroke(random(100, 255), random(100, 255), 200, 100);
          line(pt.x, pt.y, x, y);
          newPoints.push({ x, y, angle });
        }
      }
    }
    points = [...points, ...newPoints];
  } else {
    noLoop(); // Detener la animación
  }
}
